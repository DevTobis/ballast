    "@ballast/network-config": "workspace:*",
    "@ballast/observability": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

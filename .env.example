# Copy to .env and fill in for local development.

# --- Postgres (packages/db) ---
DATABASE_URL=postgres://ballast:ballast@localhost:5432/ballast

# --- Stellar network (packages/network-config) ---
STELLAR_NETWORK=local
STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_HORIZON_URL=http://localhost:8000
STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
# Any existing, funded account on the target network. packages/contract-clients uses it as the
# simulation source for read-only calls (PriceGuard.guarded_price, CreditLine.ltv) — it never
# signs or pays for anything. Needed by services/margin-monitor and services/price-guard.
STELLAR_SIMULATION_SOURCE=
# Fee-paying source account for CreditLine.poke's unsigned tx (poke is permissionless on-chain,
# but building any tx envelope still needs a source). Falls back to STELLAR_SIMULATION_SOURCE if
# unset. KNOWN GAP: this may not be the same account as KEEPER_SECRET_KEY's public key that
# services/keeper signs with — see services/keeper's report for details.
STELLAR_POKE_SOURCE=

# Contract IDs, filled in after deploy (see contracts/ README once built).
REGISTRY_CONTRACT_ID=
PRICE_GUARD_CONTRACT_ID=
PLEDGE_VAULT_CONTRACT_ID=
CREDIT_LINE_CONTRACT_ID=
EXIT_DESK_CONTRACT_ID=
REPO_DVP_CONTRACT_ID=
USDC_SAC_CONTRACT_ID=

# --- services/api ---
API_PORT=3000
WEBHOOK_HMAC_SECRET=dev-only-change-me
SEP10_SIGNING_KEY=
# Comma-separated webhook subscriber URLs. Gap: static list, not a real subscription-management
# API (every event goes to every subscriber) — see services/api's report for the follow-up.
WEBHOOK_SUBSCRIBERS=
# JSON map of institution API keys for the x-api-key/x-signature auth path, e.g.
# {"my-api-key":{"partyId":"...","stellarAccount":"G...","hmacSecret":"..."}}. Gap: stubbed as an
# env var instead of a `party` table column/secret store — see services/api's report.
INSTITUTION_API_KEYS=

# --- operator keys (services/keeper, services/payout-hop, services/price-guard) ---
# In production these resolve through KmsSigner; local dev uses a mock signer seeded here.
KEEPER_SECRET_KEY=
PAYOUT_HOP_SECRET_KEY=
PRICE_PUBLISHER_SECRET_KEY=

# --- issuer-gateway mock adapters ---
ISSUER_GATEWAY_MODE=mock

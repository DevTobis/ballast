# Reference for every variable the services read. You normally don't fill this in by hand:
# `scripts/dev-setup.sh [testnet|local]` writes a complete `.env` from a deploy's output
# (contract ids, operator keys, generated secrets). Every service loads the repo-root `.env`
# itself (`--env-file-if-exists`), so there is nothing to export.

# Node gives each IPv4/IPv6 connection attempt only 250ms by default; on a slow link RPC calls
# then fail with ETIMEDOUT even though the endpoint is reachable. dev-setup.sh sets this.
# NODE_OPTIONS=--network-family-autoselection-attempt-timeout=5000

# --- Postgres (packages/db) ---
DATABASE_URL=postgres://ballast:ballast@localhost:5432/ballast

# --- Stellar network (packages/network-config) ---
STELLAR_NETWORK=local
STELLAR_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_HORIZON_URL=http://localhost:8000
STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
# Testnet reference (uncomment and use instead of the local defaults above to point at the public
# Stellar testnet - see scripts/README.md's "Testnet end-to-end run" section):
# STELLAR_NETWORK=testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Any existing, funded account on the target network. packages/contract-clients uses it as the
# simulation source for read-only calls (PriceGuard.guarded_price, CreditLine.ltv) — it never
# signs or pays for anything. Needed by services/margin-monitor and services/price-guard.
STELLAR_SIMULATION_SOURCE=
# Default fee-paying source for CreditLine.poke when a caller doesn't name one. services/keeper
# always passes its own operator account, so this only matters to other callers of
# @ballast/contract-clients. Falls back to STELLAR_SIMULATION_SOURCE if unset.
STELLAR_POKE_SOURCE=

# Contract IDs, filled in after deploy (see contracts/ README once built).
REGISTRY_CONTRACT_ID=
PRICE_GUARD_CONTRACT_ID=
PLEDGE_VAULT_CONTRACT_ID=
CREDIT_LINE_CONTRACT_ID=
EXIT_DESK_CONTRACT_ID=
REPO_DVP_CONTRACT_ID=
USDC_SAC_CONTRACT_ID=

# --- services/api ---
API_PORT=3000
# 32 random bytes as 64 hex chars (openssl rand -hex 32). Encrypts per-subscription webhook
# signing secrets at rest; webhooks are disabled while this is unset.
WEBHOOK_SECRET_KEY=
# HMAC secret this service signs/verifies its own session JWTs with (`{ sub: G-address }`).
# Required (non-empty) whenever NODE_ENV=production.
JWT_SIGNING_SECRET=
# Real Stellar keypair secret (S...) the SEP-10 challenge/response flow (services/api/src/routes/
# auth.ts) signs challenge transactions with. Distinct from JWT_SIGNING_SECRET on purpose.
# Required (non-empty) whenever NODE_ENV=production. Generate one with `stellar keys generate`.
SEP10_SERVER_SECRET=
SEP10_HOME_DOMAIN=localhost
SEP10_WEB_AUTH_DOMAIN=localhost
# Origin allowed to call this API from a browser (apps/console). Passed to @fastify/cors's
# `origin` option — never `*`. Required (non-empty) whenever NODE_ENV=production.
CONSOLE_ORIGIN=http://localhost:5173
# Explicit opt-in for the dev-only raw-G-address login (services/api/src/routes/dev-auth.ts,
# POST /v1/auth/dev-login) — mints a JWT with no proof of Stellar key ownership. Off by default,
# including in local dev; the console UI never calls it regardless of this flag. Never set this
# in production: the API refuses to start with this set when NODE_ENV=production.
ENABLE_DEV_LOGIN=false
# Alerts (stale or halted prices, margin calls, low operator balances, indexer lag) are always
# logged. Set this to also POST them to a Slack/Discord/generic webhook; the same alert for the same
# asset or line is sent at most once per ALERT_COOLDOWN_S (default 900). OPERATOR_MIN_XLM (default
# 20) is the balance below which the keeper and price publisher accounts raise an alert.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_S=900
OPERATOR_MIN_XLM=20
# Behind a reverse proxy (Render, Caddy, a load balancer) set this so the API sees each client's real
# address (rate limits and the failed-login lockout are per address). `true`, a hop count such as `1`,
# or a comma-separated list of proxy CIDRs. Leave it unset with no proxy in front: trusting the header
# then lets any client choose its own address.
TRUST_PROXY=
# Run the KYB + OFAC sanctions gate in front of lending, pledging, drawing, exit and repo routes.
# Accepts true/false or 1/0 (case-insensitive). Defaults to true when NODE_ENV=production and false
# otherwise (the screener downloads the OFAC SDN list).
# Approve parties with: pnpm --filter @ballast/db compliance kyb <partyId> approved
COMPLIANCE_ENFORCED=
# 32 random bytes as 64 hex chars (openssl rand -hex 32). Encrypts institution API-key signing
# secrets at rest. Keys are created by a signed-in party via POST /v1/api-keys; API-key auth is
# unavailable while this is unset.
API_KEY_SECRET_KEY=

# --- operator keys (services/keeper, services/payout-hop, services/price-guard) ---
# In production these resolve through a KmsSigner (see "operator signer modes" below); local dev
# (the default "local" mode) reads a raw secret from the matching var below.
KEEPER_SECRET_KEY=
PAYOUT_HOP_SECRET_KEY=
PRICE_PUBLISHER_SECRET_KEY=

# --- operator signer modes (packages/operator-signing) ---
# Per-role dispatch: "local" (default, raw secret from *_SECRET_KEY above) | "vault" (HashiCorp
# Vault Transit) | "kms-envelope" (AWS KMS-wrapped secret, decrypted in-process). See
# packages/operator-signing's README/src/factory.ts for details.
# Keeper job schedules (cron). Defaults shown; dev-setup.sh runs them all every minute.
# KEEPER_SYNC_COLLATERAL_CRON="* * * * *"
# KEEPER_CURE_EXPIRY_CRON="*/5 * * * *"
# KEEPER_REPO_UNWIND_CRON="*/5 * * * *"
# KEEPER_INTEREST_ACCRUAL_CRON="0 * * * *"
KEEPER_SIGNER_MODE=local
PRICE_PUBLISHER_SIGNER_MODE=local
PAYOUT_HOP_SIGNER_MODE=local

# "vault" mode: HashiCorp Vault Transit engine, shared address + a per-role Transit key name.
# Authenticate with AppRole (the signer renews its own token) or, less well, a fixed VAULT_TOKEN
# that cannot be renewed and stops working when it expires. VAULT_NAMESPACE is for Enterprise.
# "local" mode throws when NODE_ENV=production.
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_TOKEN=
VAULT_NAMESPACE=
KEEPER_VAULT_KEY_NAME=
PRICE_PUBLISHER_VAULT_KEY_NAME=
PAYOUT_HOP_VAULT_KEY_NAME=

# "kms-envelope" mode: AWS KMS Decrypt unwraps a per-role base64-encoded wrapped secret.
AWS_REGION=
KEEPER_KMS_KEY_ID=
PRICE_PUBLISHER_KMS_KEY_ID=
PAYOUT_HOP_KMS_KEY_ID=
KEEPER_WRAPPED_SECRET=
PRICE_PUBLISHER_WRAPPED_SECRET=
PAYOUT_HOP_WRAPPED_SECRET=

# --- issuer-gateway (services/issuer-gateway) ---
# There is no mock mode. An issuer is served only when its back-office is configured; an
# unconfigured issuer's endpoints return an error, never an approval. The SEP-8 leg follows the
# real approval-server protocol (take the URL from the issuer's stellar.toml APPROVAL_SERVER).
# The bespoke back-office endpoints (authorizations, liens, redemptions) are NOT verified against
# any real issuer API - none publishes one - and need replacing with what each issuer provides
# under its integration agreement. Nothing else in the stack calls this service yet.
# Per-request HTTP timeout for issuer APIs and SEP-8 approvals, including the response body.
# Positive integer milliseconds (1-2147483647); defaults to 15000. Requests are not auto-retried.
ISSUER_GATEWAY_TIMEOUT_MS=15000
SPIKO_API_BASE_URL=
SPIKO_API_KEY=
SPIKO_SEP8_APPROVAL_SERVER_URL=
ETHERFUSE_API_BASE_URL=
ETHERFUSE_API_KEY=
ETHERFUSE_SEP8_APPROVAL_SERVER_URL=
FRANKLIN_API_BASE_URL=
FRANKLIN_API_KEY=
FRANKLIN_SEP8_APPROVAL_SERVER_URL=

# --- price-guard sources (services/price-guard) ---
# Every price is read from a real source; there is no mock mode.
#   issuer NAV : Spiko  - https://public-api.spiko.io/v0 (public, no key; USD share classes only)
#                Etherfuse - https://api.etherfuse.com/lookup/tokens/cost/{symbol} (public, no key)
#                Franklin  - no public NAV API: its assets are priced from the oracle alone, so the
#                            on-chain guard reports them Degraded (one source) rather than Ok.
#   oracle     : RedStone per-asset feed contracts on Stellar mainnet (read_price_data).
# Override only to point at a proxy/mirror:
SPIKO_NAV_API_BASE_URL=
ETHERFUSE_NAV_API_BASE_URL=
# JSON map of assetCode -> RedStone feed contract id. Verified mainnet feeds (2026-10-08):
#   CETES   CCYGBQZ5JKE2TGK2XNNVIZRKFEIT27NZADS3XJFSO4CCIH3LHIUP34LG
#   USTRY   CAEGYZFAJ3HLSDBUIVJ77SK5HLLS4MPE4LO5OB2W3L2TEDMAS6RCTMZ4
#   TESOURO CAO3JDDO52PV5SNIR4WRLBNTE72CY6B4JO5PNSSRRM4TC5DZ5X5ZSJVC
#   BENJI   CCDM2U5E3SBMPJUQCBIER4BSFAVSJTY5I5EQEZIRDZSA3YOJH3YM4TW5  (BENJI_ETHEREUM_FUNDAMENTAL, flat $1.00)
REDSTONE_FEED_CONTRACT_IDS=
# RedStone publishes RWA feeds on mainnet only. Set these to read them from there while publishing
# to testnet/local; leave empty on mainnet.
REDSTONE_RPC_URL=
REDSTONE_NETWORK_PASSPHRASE=
# JSON map of assetCode -> the issuer's symbol, for tokens whose code differs from it
# (e.g. {"RWA1":"USTRY"}). Unmapped assets use their own code.
ISSUER_NAV_SYMBOLS=
# false = shadow run: record real readings and flag source disagreement, send nothing on-chain,
# need no PriceGuard contract or publisher key.
PRICE_GUARD_PUBLISH=true

# --- Internal services (payout-hop, issuer-gateway) ---------------------------------------------
# Shared secret every request to an internal service must carry in x-internal-token. Both services
# refuse to start without it (at least 32 characters: openssl rand -hex 32). They listen on
# 127.0.0.1 unless PAYOUT_HOP_HOST / ISSUER_GATEWAY_HOST say otherwise.
INTERNAL_API_TOKEN=
# payout-hop moves the operator's own USDC, so what a request may ask for is fixed here, not by the
# caller: the USDC issuer, the only anchor accounts it may pay (comma-separated G-addresses), and the
# largest single payout in whole USDC (default 5000). Each first-leg transaction is paid once.
PAYOUT_HOP_USDC_ISSUER=
PAYOUT_HOP_ALLOWED_DESTINATIONS=
PAYOUT_HOP_MAX_AMOUNT=5000
